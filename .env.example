# Configuración general
PROJECT_NAME="m3notifybot"
VERSION="0.1.0"
DEBUG=false

# Telegram — Obtener del BotFather y de /getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Clave API para autenticar peticiones entrantes
NOTIFICATION_API_KEY=

# Base de datos (ruta para Docker; para desarrollo local usar sqlite:///data/database.db)
DATABASE_URL="sqlite:////app/data/database.db"

# Timeout en segundos para peticiones HTTP salientes
HTTP_TIMEOUT_SECONDS=10.0
